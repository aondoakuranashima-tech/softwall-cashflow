# syntax=docker/dockerfile:1
# Reusable baseline for Next.js, NestJS, billing-api and workers.
# Individual applications can extend this image when their build contracts are finalized.
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
WORKDIR /workspace

FROM base AS deps
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* turbo.json* ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile=false

FROM deps AS build
ARG APP_NAME
ENV NODE_ENV=production
RUN if [ -n "$APP_NAME" ]; then pnpm --filter "$APP_NAME" build; else pnpm build; fi

FROM base AS runtime
ENV NODE_ENV=production
RUN useradd --system --create-home --uid 10001 appuser
COPY --from=build /workspace /workspace
RUN chown -R appuser:appuser /workspace
USER appuser
WORKDIR /workspace

# Override CMD in each application image. This generic image is intentionally not runnable by itself.
CMD ["node", "--version"]
