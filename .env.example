# Softwall CashFlow environment template
# SAFE TO COMMIT. Never put real credentials here.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/softwall_cashflow
REDIS_URL=redis://localhost:6379

# Authentication / application secrets
AUTH_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-32-byte-key

# Integrations — development placeholders only
PLAID_CLIENT_ID=
PLAID_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Billing provider credentials — never commit real values
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
DODO_API_KEY=
PADDLE_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Observability
SENTRY_DSN=
